{
  "name": "pm-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate":        "node-pg-migrate -m migrations -j sql",
    "migrate:up":     "node-pg-migrate -m migrations -j sql up",
    "migrate:down":   "node-pg-migrate -m migrations -j sql down",
    "migrate:create": "node-pg-migrate -m migrations -j sql create",
    "test:e2e":       "node test/auth.e2e.mjs",
    "test:e2e:local": "node test/run-e2e.mjs"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^7.6.1",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  }
}
