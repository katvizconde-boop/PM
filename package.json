{
  "name": "pm",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev":            "vercel dev",
    "build":          "cd frontend && npm install && npm run build",
    "migrate":        "node-pg-migrate -m migrations -j sql",
    "migrate:up":     "node-pg-migrate -m migrations -j sql up",
    "migrate:down":   "node-pg-migrate -m migrations -j sql down",
    "migrate:create": "node-pg-migrate -m migrations -j sql create",
    "test:e2e":       "node test/auth.e2e.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.6.1",
    "pg": "^8.13.0"
  }
}
