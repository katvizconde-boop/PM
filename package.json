{
  "name": "pm",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build":          "cd frontend && npm install && npm run build",
    "migrate:up":     "node scripts/migrate.mjs up",
    "migrate:down":   "node scripts/migrate.mjs down",
    "migrate:create": "node-pg-migrate -m migrations -j sql create",
    "seed:demo":      "node scripts/seed-demo.mjs",
    "test:e2e":       "node test/auth.e2e.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.6.1",
    "ws": "^8.18.0"
  }
}
